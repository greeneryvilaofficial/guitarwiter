+    /**
+     * Coba buat AudioRecord lewat jalur low-latency Android (AudioRecord.Builder +
+     * PERFORMANCE_MODE_LOW_LATENCY, API 26+) memakai AudioSource.VOICE_RECOGNITION
+     * -- bukan MediaRecorder.AudioSource.MIC biasa. Dua alasan:
+     *   1. VOICE_RECOGNITION diminta Android sebagai sumber "raw", jadi sistem
+     *      MEMATIKAN AGC/noise-suppression/echo-cancellation bawaan OEM di sana --
+     *      persis yang kita mau buat deteksi pitch (sinyal mentah, tidak diproses),
+     *      konsisten dengan constraint getUserMedia() di index.html
+     *      (echoCancellation:false, noiseSuppression:false, autoGainControl:false).
+     *   2. PERFORMANCE_MODE_LOW_LATENCY mengarahkan Android memakai jalur audio
+     *      cepat (AAudio/fast mixer) kalau perangkat mendukung -- biasanya memangkas
+     *      20-50ms dari latensi hardware/OS sebelum sampel audio sampai ke kita,
+     *      di luar kendali algoritma YIN/hop yang sudah dioptimasi di file ini.
+     * Kalau Builder tidak tersedia (API lama) atau constructor gagal untuk alasan
+     * apa pun, balikin null -- start() akan otomatis pakai constructor lama sebagai
+     * cadangan, jadi tidak ada perangkat yang jadi tidak bisa merekam sama sekali.
+     */
+    private AudioRecord buildLowLatencyAudioRecord(int rate, int bufSize) {
+        if (android.os.Build.VERSION.SDK_INT < android.os.Build.VERSION_CODES.M) {
+            return null; // AudioRecord.Builder baru ada dari API 23
+        }
+        try {
+            AudioFormat format = new AudioFormat.Builder()
+                    .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+                    .setSampleRate(rate)
+                    .setChannelMask(AudioFormat.CHANNEL_IN_MONO)
+                    .build();
+            AudioRecord.Builder builder = new AudioRecord.Builder()
+                    .setAudioSource(MediaRecorder.AudioSource.VOICE_RECOGNITION)
+                    .setAudioFormat(format)
+                    .setBufferSizeInBytes(bufSize);
+            if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.O) {
+                builder.setPerformanceMode(AudioRecord.PERFORMANCE_MODE_LOW_LATENCY);
+            }
+            AudioRecord rec = builder.build();
+            if (rec.getState() != AudioRecord.STATE_INITIALIZED) {
+                rec.release();
+                return null;
+            }
+            return rec;
+        } catch (Exception e) {
+            // Sebagian OEM/emulator melempar exception aneh di kombinasi tertentu --
+            // aman diabaikan, tinggal jatuh ke constructor lama di start().
+            return null;
+        }
+    }
